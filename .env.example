# acme-rollout - copy to .env and chmod 600.
#
# acme-dns endpoint. The image ships the same value as a safe default, so the
# acme.sh plugin never falls back to the public auth.acme-dns.io service.
ACMEDNS_BASE_URL=https://auth.example.com

# Target user created by the acme-target recipe on every host.
# DEPLOY_USER=acmepush

# Directory on the target hosts. Default is /etc/ssl; only set this when the
# acme-target recipe accepts the optional second install argument (see README).
# DEPLOY_PATH=/etc/ssl

# Alerts. Without SMTP_HOST the alert is only written to the container log.
# NOTIFY_BACKEND=smtp relays via SMTP_HOST below; postfix hands the mail to
# the host MTA at host.docker.internal:25 without TLS or login.
# NOTIFY_BACKEND=smtp
ALERT_EMAIL=ops@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# starttls (587), smtps (465) or none
# SMTP_TLS=starttls
# repeat an unchanged alert at most once per day
# ALERT_EVERY=86400

# --- cycle ---
# seconds between rounds (default 21600 = 6 h)
# ACME_INTERVAL=21600
# 1 = run a single round and exit (debugging)
# ACME_CYCLES=0
# warn when a certificate expires within this many days
# EXPIRY_WARN_DAYS=21

# --- deploy ---
# concurrent SSH connections (max 16)
# DEPLOY_PARALLEL=4
# re-push a host after this many seconds without a successful deploy
# DEPLOY_SYNC_AGE=86400
# first retry after a failed deploy, doubled per failure up to the maximum
# DEPLOY_SYNC_RETRY=21600
# DEPLOY_SYNC_MAX_RETRY=86400
